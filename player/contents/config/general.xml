    <group name="General">
        <entry name="title" type="String"><default>player</default></entry>
        <entry name="showSourceSwitcher" type="Bool"><default>true</default></entry>
        <!-- 0 = Nerd Font glyphs when a Nerd Font is installed, else the icon theme; 1 = Nerd Font; 2 = icon theme -->
        <entry name="iconStyle" type="Int"><default>0</default></entry>
        <!-- volume change per mouse wheel notch, in percent; Shift + wheel uses the fine step -->
        <entry name="volumeStep" type="Int"><default>5</default></entry>
        <entry name="fineVolumeStep" type="Int"><default>1</default></entry>
        <!-- music-cli integration (needs extras/music-cli installed) -->
        <entry name="musicCli" type="Bool"><default>false</default></entry>
        <entry name="helperCommand" type="String"><default>neonglass-player</default></entry>
        <entry name="tuiCommand" type="String"><default>kitty -e music-cli</default></entry>
        <entry name="showUpNext" type="Bool"><default>true</default></entry>
        <!-- draw the rounded glass frame behind the panel version (turn off inside Panel Colorizer islands) -->
        <entry name="panelFrame" type="Bool"><default>true</default></entry>
    </group>
