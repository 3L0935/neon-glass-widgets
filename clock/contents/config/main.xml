<?xml version="1.0" encoding="UTF-8"?>
<!-- generated by tools/sync-shared.sh: edit config/general.xml or shared/appearance.xml -->
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>
    <group name="General">
        <entry name="title" type="String"><default>clock</default></entry>
        <!-- right label in the top edge: sun | date | none -->
        <entry name="rightLabel" type="String"><default>sun</default></entry>
        <entry name="use24h" type="Bool"><default>true</default></entry>
        <entry name="showSeconds" type="Bool"><default>true</default></entry>
        <!-- empty = system locale -->
        <entry name="locale" type="String"><default></default></entry>
        <entry name="dateFormat" type="String"><default>ddd, MMM d</default></entry>
        <entry name="lowercaseDate" type="Bool"><default>true</default></entry>
        <entry name="showWeekDay" type="Bool"><default>true</default></entry>
        <!-- empty = numbers font from Appearance -->
        <entry name="digitsFont" type="String"><default></default></entry>
        <entry name="digitsWeight" type="Int"><default>200</default></entry>
        <entry name="showSun" type="Bool"><default>true</default></entry>
        <entry name="latitude" type="Double"><default>48.86</default></entry>
        <entry name="longitude" type="Double"><default>2.35</default></entry>
        <entry name="showTicks" type="Bool"><default>true</default></entry>
        <entry name="showZones" type="Bool"><default>true</default></entry>
        <!-- comma separated, "Area/City=LABEL" or just "UTC" -->
        <entry name="zones" type="String"><default>America/Los_Angeles=LA, America/New_York=NYC, UTC, Asia/Tokyo=TYO</default></entry>
    </group>
    <!-- shared by every Neon Glass widget (tools/sync-shared.sh keeps the packages in sync) -->
    <group name="Appearance">
        <entry name="accentColor" type="Color"><default>#46b5e7</default></entry>
        <entry name="secondaryColor" type="Color"><default>#a55ae9</default></entry>
        <entry name="tertiaryColor" type="Color"><default>#e45ad8</default></entry>
        <entry name="textColor" type="Color"><default>#e8e6ff</default></entry>
        <entry name="mutedColor" type="Color"><default>#9a94d0</default></entry>
        <entry name="faintColor" type="Color"><default>#5d579a</default></entry>
        <entry name="glassColor" type="Color"><default>#120f2e</default></entry>
        <entry name="glassOpacity" type="Double"><default>0.62</default></entry>
        <entry name="edgeColor" type="Color"><default>#8c82e6</default></entry>
        <entry name="edgeOpacity" type="Double"><default>0.20</default></entry>
        <entry name="cornerRadius" type="Int"><default>12</default></entry>
        <!-- pixel size of the labels set into the top edge, the same on every widget whatever its size -->
        <entry name="labelSize" type="Int"><default>17</default></entry>
        <entry name="sansFont" type="String"><default></default></entry>
        <entry name="monoFont" type="String"><default></default></entry>
        <!-- path of the image drawn (blurred) under the card; empty = plain glass -->
        <entry name="backgroundImage" type="String"><default></default></entry>
        <entry name="blurAmount" type="Double"><default>1.0</default></entry>
    </group>
</kcfg>
